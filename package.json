{
  "name": "ahmad-awais-deepseek-v4-toolrepair",
  "version": "1.1.1",
  "description": "Auto-repair tool-calling quirks for DeepSeek V4 in Claude Code CLI and OpenCode — making open models beat Opus 4.7",
  "license": "MIT",
  "author": "Ahmad Awais (original insight) + toolrepair contributors",
  "keywords": [
    "deepseek",
    "claude-code",
    "opencode",
    "tool-calling",
    "repair",
    "ai-coding"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TeFuirnever/ahmad-awais-deepseek-v4-toolrepair.git"
  },
  "bugs": "https://github.com/TeFuirnever/ahmad-awais-deepseek-v4-toolrepair/issues",
  "homepage": "https://github.com/TeFuirnever/ahmad-awais-deepseek-v4-toolrepair#readme",
  "bin": {
    "ahmad-awais-deepseek-v4-toolrepair": "bin/cli.js",
    "toolrepair": "bin/cli.js"
  },
  "main": "./src/index.js",
  "module": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/**/*.test.js",
    "test:bun": "bun test",
    "test:deno": "deno test --allow-read --allow-write --allow-env --allow-net --allow-run --unstable-sloppy-imports --unstable-detect-cjs test/**/*.test.js",
    "verify": "node bin/cli.js verify"
  },
  "engines": {
    "node": ">=18"
  }
}
